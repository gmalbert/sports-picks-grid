{
  "name": "sports-picks-grid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-web-data.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run prepare:data && vite build",
    "preview": "wrangler dev",
    "test": "npm run prepare:data && node --test tests/web/*.test.js",
    "check": "npm test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "vite": "^7.1.0", "@vitejs/plugin-react": "^5.0.0", "wrangler": "^4.45.0" },
  "engines": { "node": ">=22.12" }
}
